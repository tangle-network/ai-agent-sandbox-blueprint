# syntax=docker/dockerfile:1.7
#
# Blueprint-owned all-harness sidecar.
#
# This image owns the sidecar server and agent harness layer, so the public
# blueprint does not depend on a private ADC runtime image.
#
# Build:
#   docker build -f sidecar/Dockerfile.all-harness \
#     -t ghcr.io/tangle-network/blueprint-sidecar:all-harness .

FROM node@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436 AS harnesses

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash build-essential ca-certificates curl git libffi-dev python3 python3-dev unzip \
  && rm -rf /var/lib/apt/lists/*

RUN bun_dir="$(mktemp -d)" \
  && curl --fail --silent --show-error --location \
    --retry 3 --retry-delay 2 --retry-all-errors \
    --connect-timeout 15 --max-time 300 \
    -o "$bun_dir/bun.zip" \
    https://github.com/oven-sh/bun/releases/download/bun-v1.3.14/bun-linux-x64.zip \
  && echo '951ee2aee855f08595aeec6225226a298d3fea83a3dcd6465c09cbccdf7e848f  '"$bun_dir/bun.zip" | sha256sum -c - \
  && unzip -p "$bun_dir/bun.zip" bun-linux-x64/bun > /usr/local/bin/bun \
  && chmod 0755 /usr/local/bin/bun \
  && rm -rf "$bun_dir"

COPY sidecar/scripts/install-harness.sh /usr/local/share/blueprint-sidecar/install-harness.sh
RUN set -eu; \
  sh /usr/local/share/blueprint-sidecar/install-harness.sh all; \
  mkdir -p /home/agent/.config/amp /home/agent/.local /root/.hermes

FROM node@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436 AS runtime

USER root

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash ca-certificates curl git openssh-client python3 tini unzip \
  && rm -rf /var/lib/apt/lists/* \
  && existing_group="$(getent group 1000 | cut -d: -f1 || true)" \
  && if [ -n "$existing_group" ] && [ "$existing_group" != agent ]; then groupmod --new-name agent "$existing_group"; elif [ -z "$existing_group" ]; then groupadd --gid 1000 agent; fi \
  && existing_user="$(getent passwd 1000 | cut -d: -f1 || true)" \
  && if [ -n "$existing_user" ] && [ "$existing_user" != agent ]; then usermod --login agent --home /home/agent --move-home --shell /bin/bash "$existing_user"; elif [ -z "$existing_user" ]; then useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash agent; fi \
  && if ! getent group sidecar >/dev/null; then groupadd --gid 1001 sidecar; fi \
  && if ! id sidecar >/dev/null 2>&1; then useradd --uid 1001 --gid sidecar --create-home --shell /bin/bash sidecar; fi \
  && mkdir -p /home/agent/.config/amp /home/agent/.cache /home/agent/.claude \
    /home/agent/.codex /home/agent/.config/kimi /home/agent/.config/opencode \
    /home/agent/.copilot /home/agent/.factory /home/agent/.forge \
    /home/agent/.gemini /home/agent/.kimi /home/agent/.opencode \
    /home/agent/.hermes /home/agent/.prime/agent \
    /home/agent/.openclaw /home/agent/.pi /home/agent/.qwen \
    /home/agent/workspace \
  && chown -R agent:agent /home/agent

COPY --from=harnesses /usr/local/ /usr/local/
COPY --chown=agent:agent --from=harnesses /home/agent/.config/amp/ /home/agent/.config/amp/
COPY --chown=agent:agent --from=harnesses /home/agent/.local/ /home/agent/.local/
COPY --chown=agent:agent --from=harnesses /root/.hermes/ /home/agent/.hermes/

COPY sidecar/server/ /opt/blueprint-sidecar/
COPY sidecar/scripts/verify-harnesses.sh /usr/local/bin/blueprint-verify-harnesses
RUN chmod +x /usr/local/bin/blueprint-verify-harnesses \
  && blueprint-verify-harnesses

ENV PATH="/home/agent/.local/bin:/usr/local/bin:${PATH}"
ENV SIDECAR_CAPABILITIES="all_harness"
ENV SIDECAR_HARNESSES="all"
ENV SIDECAR_PORT=8080
ENV AGENT_WORKSPACE_ROOT="/home/agent/workspace"
ENV AGENT_SUBPROCESS_UID=1000
ENV AGENT_SUBPROCESS_GID=1000
ENV PRIME_AGENT_INSTALL_UV=1

VOLUME /home/agent/.claude
VOLUME /home/agent/.codex
VOLUME /home/agent/.kimi
VOLUME /home/agent/.config/kimi
VOLUME /home/agent/.gemini
VOLUME /home/agent/.config/opencode
VOLUME /home/agent/.opencode
VOLUME /home/agent/.config/amp
VOLUME /home/agent/.prime
VOLUME /home/agent/.hermes
VOLUME /home/agent/.factory
VOLUME /home/agent/.forge
VOLUME /home/agent/.openclaw
VOLUME /home/agent/.pi
VOLUME /home/agent/.qwen
VOLUME /home/agent/.copilot

LABEL org.opencontainers.image.title="Tangle Blueprint Sidecar All-Harness"
LABEL org.opencontainers.image.description="AI Agent Sandbox sidecar with 14 CLI backends, including Prime Agent, Hermes, AMP, and Factory Droids"
LABEL org.opencontainers.image.source="https://github.com/tangle-network/ai-agent-sandbox-blueprint"
LABEL org.tangle.sidecar.harnesses="all"

EXPOSE 8080
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "/opt/blueprint-sidecar/server.js"]
